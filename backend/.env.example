PORT=5000

# MongoDB Atlas (recommended). Replace USER, PASSWORD, and cluster host with yours.
# URL-encode special characters in the password (e.g. @ → %40).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/grabit-hot?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Admin dashboard login (used by npm run seed:admin). Defaults: admin@gmail.com / ali12345@@
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=ali12345@@

# Ticket-sale alerts go here (comma-separated). Use the same Gmail you send from.
ADMIN_ALERT_EMAIL=grabithot@gmail.com

# --- Gmail SMTP (grabithot@gmail.com) ---
# 1. Turn on 2-Step Verification for the Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. SMTP_USER and FROM_EMAIL must BOTH be grabithot@gmail.com (not noreply@…)
# 4. Set these same variables on IONOS / your host (backend .env is not deployed from git)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=grabithot@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
FROM_EMAIL=grabithot@gmail.com
FROM_NAME=Grab It Hot

# One or more allowed browser origins (comma-separated). Localhost is always allowed for dev.
# Example: https://mydomain.com,https://www.mydomain.com
CLIENT_URL=http://localhost:3000
