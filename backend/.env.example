PORT=5000

# MongoDB Atlas (recommended). Replace USER, PASSWORD, and cluster host with yours.
# URL-encode special characters in the password (e.g. @ → %40).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/grabit-hot?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Admin dashboard login (used by npm run seed:admin). Defaults: admin@gmail.com / ali12345@@
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=ali12345@@

# Email alert when someone requests or buys tickets (comma-separated for multiple). Defaults to ADMIN_EMAIL.
ADMIN_ALERT_EMAIL=admin@gmail.com

# --- Email (SMTP) ---
# On IONOS: use your IONOS mailbox — SMTP_USER and FROM_EMAIL must be the SAME full address.
# IONOS US: smtp.ionos.com | port 587 (or 465 with SMTP_SECURE=true)
#
# SMTP_HOST=smtp.ionos.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=hello@yourdomain.com
# SMTP_PASS=your_ionos_mailbox_password
# FROM_EMAIL=hello@yourdomain.com
#
# Gmail (local dev): use an App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Grab It Hot

# One or more allowed browser origins (comma-separated). Localhost is always allowed for dev.
# Example: https://mydomain.com,https://www.mydomain.com
CLIENT_URL=http://localhost:3000
